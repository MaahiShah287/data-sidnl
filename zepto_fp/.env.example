# Copy to .env (never commit .env). Credentials live ONLY here / in your secret store.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
VAULT_KEY=                      # generate with: python -m zepto_fp.run vault-key
HEADLESS=1
RAW_DIR=data/raw
ALERT_WEBHOOK_URL=              # Slack/Teams-style webhook that receives failure alerts

# --- OTP mailbox (our own Microsoft 365 mailbox that clients forward Zepto OTP emails to) ---
# Azure app registration with APPLICATION permission Mail.Read, restricted to this one mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=otp@yourcompany.com
OTP_SENDER_HINT=zepto

# --- only for a database-less dry run (otherwise companies come from ops.fp_accounts) ---
# ZEPTO_NAME=mr_munchies
# ZEPTO_BRAND=Mr. Munchies
# ZEPTO_EMAIL=
