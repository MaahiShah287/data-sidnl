# ============================================================
# SIDNL Chatbot — Environment Variables (.env.example)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Supabase / Postgres — read-only role `sidnl_chatbot_app` (non-superuser,
# SELECT-only grants). Use the IPv4 SESSION POOLER host: the direct
# `db.<ref>.supabase.co` host is IPv6-only and fails on IPv6-less networks.
# Note the pooler needs `<user>.<project-ref>` as the username.
DATABASE_URL=postgresql://sidnl_chatbot_app.<PROJECT_REF>:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- LLM provider (OpenAI OR Groq — pick ONE, key/URL/models must match) ---
LLM_PROVIDER=openai
# OpenAI:  LLM_API_KEY=sk-...         LLM_API_BASE=https://api.openai.com/v1
# Groq:    LLM_API_KEY=gsk_...        LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=sk-...
LLM_API_BASE=https://api.openai.com/v1
LLM_GENERATOR_MODEL=gpt-4o-mini
LLM_CRITIC_MODEL=gpt-4o-mini
LLM_ROUTER_MODEL=gpt-4o-mini

# Embeddings (local Sentence Transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=sidnl_docs

# RAG settings
RETRIEVAL_TOP_K=8
RERANK_ENABLED=false
RERANK_TOP_N=4
MAX_RETRIES=2

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Documentation corpus (DEFINITION questions). Relative paths resolve from Rag/.
# Defaults to ../data-sidnl/docs when unset.
DOCS_DIR=../data-sidnl/docs
