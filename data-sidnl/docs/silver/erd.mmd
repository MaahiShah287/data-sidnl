    brand_scope {
        text brand_key PK
        text brand_name
        text_arr raw_brand_aliases
        bool is_enabled
    }
    dim_platform {
        text platform PK
        bool is_test
    }
    dim_city {
        text city_slug PK
        text city_name
        text state
    }
    dim_brand {
        text brand_key PK
        text brand_name
        text company_name
    }
    dim_store {
        bigint store_key PK
        text platform
        text store_external_id
        bigint source_store_id UK
        text store_name
        text city_slug FK
        numeric latitude
        numeric longitude
    }
    dim_category {
        bigint category_key PK
        text l1_name
        text l2_name
        text l3_name
        text category_path
    }
    dim_product {
        bigint product_key PK
        text platform
        text platform_product_id
        text brand_key FK
        text product_name
        text variant
        text product_type
        text pack_raw
        numeric size_value
        text size_unit
        int pack_count
        numeric total_content
        bigint category_key FK
    }
    canonical_product {
        text sidnl_id PK
        text brand_key FK
        text canonical_name
        text variant
        numeric size_value
        text size_unit
        int pack_count
        bool is_active
        text merged_into FK
    }
    product_xref {
        int product_key PK,FK
        text sidnl_id FK
        text match_status
        text match_method
        numeric score
    }
    match_review_queue {
        bigint review_id PK
        int product_key FK
        text suggested_sidnl_id FK
        numeric score
        text status
    }
    category_scope {
        text platform PK,FK
        text l1_id PK
        text l2_id PK
        text l1_name
        text l2_name
        bool is_enabled
    }
    fact_store_scan {
        bigint snapshot_id PK
        text platform
        text brand_key
        bigint store_key FK
        timestamptz scanned_at
        text scan_status
        bool stopped_early
        bool is_valid_denominator
    }
    fact_product_reading {
        bigint reading_key PK
        text source_type
        text source_record_id UK
        bigint product_key FK
        bigint store_key FK
        bigint snapshot_id
        timestamptz observed_at
        date obs_date
        text stock_status
