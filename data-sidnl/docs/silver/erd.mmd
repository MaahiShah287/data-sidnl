        numeric mrp
        numeric discount_pct
        int search_position
        bool is_ad
        bool osa_eligible
        text dq_status
        text_arr dq_flags
    }
    fact_shelf_position {
        bigint shelf_pos_key PK
        bigint source_record_id UK
        bigint snapshot_id
        text platform FK
        text l1_id
        text l2_id
        int product_key FK
        int store_key FK
        text city_slug FK
        timestamptz observed_at
        date obs_date
        int shelf_position
        text brand_key
        numeric selling_price
        numeric mrp
        text dq_status
    }
    freshness_policy {
        text source_type PK
        int fresh_within_hours
    }
    ops_etl_run {
        bigint run_id PK
        text brand_key
        text status
        jsonb stats
    }
    ref_metric_support {
        int metric_id PK
        text metric
        text support
    }
