[Unit]
Description=SIDNL live pipeline (HTTP receiver + micro-batch loader + normalise/match)
After=network-online.target

[Service]
WorkingDirectory=/path/to/sidnl
EnvironmentFile=/etc/sidnl.env
ExecStart=/path/to/sidnl/.venv/bin/python -m sidnl.cli live --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
