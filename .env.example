# =============================================================================
# SIDNL .env.example — copy to .env and fill in. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
# =============================================================================

# --- Admin DB connection (for scripts/load_first_party.py and SQL fixes) ---
# Supabase > Connect > Session pooler. Format:
#   postgresql://postgres.<PROJECT-REF>:<POSTGRES-PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# This is the POSTGRES ADMIN password — it can change/delete anything.
# Only set it on your own machine; never share, never commit.
SUPABASE_DB_URL=

# --- Read-only DB connection (chatbot role, from sql/03_roles.sql) ---
# Used by Rag/ and any read-only API. Same pooler host, role user.
DATABASE_URL=
